splay_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Product Subcategories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="145"/><column index="2" value="143"/><column index="3" value="125"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="1" mode="0"/></sort><column_widths><column index="1" value="73"/><column index="2" value="145"/><column index="3" value="87"/><column index="4" value="263"/><column index="5" value="223"/><column index="6" value="300"/><column index="7" value="103"/><column index="8" value="75"/><column index="9" value="81"/><column index="10" value="79"/><column index="11" value="80"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Returns" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="2" mode="1"/></sort><column_widths><column index="1" value="87"/><column index="2" value="80"/><column index="3" value="73"/><column index="4" value="96"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Sales Territories" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="110"/><column index="2" value="119"/><column index="3" value="119"/><column index="4" value="111"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="7" mode="1"/></sort><column_widths><column index="1" value="79"/><column index="2" value="87"/><column index="3" value="84"/><column index="4" value="73"/><column index="5" value="84"/><column index="6" value="80"/><column index="7" value="91"/><column index="8" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Data cleaning">Select *
from Customers
where LastName is NULL;
DELETE
FROM Customers
WHERE LastName is NULL;

SELECT *
FROM Customers
WHERE LastName is NULL;

SELECT 
    CustomerKey,
    COUNT(*) AS total_purchases
FROM Sales
GROUP BY CustomerKey
ORDER by total_purchases DESC;</sql><sql name="Data analysis">--CAlCULATE USER RETENTION RATE
SELECT 
    user_type,
    COUNT(*) AS user_count,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER(), 1) AS percentage
FROM (
    SELECT 
        CustomerKey,
        CASE 
            WHEN COUNT(*) = 1 THEN 'One-time User'
            ELSE 'Repeat User'
        END AS user_type
    FROM Sales
    GROUP BY CustomerKey
) 
GROUP BY user_type;

-- COUNT OF Orders -&gt; Repeats -&gt; Returns BY CATEGORY 
WITH CategorySales AS (
    -- Calculate Sales and Loyalty metrics
    SELECT 
        pc.CategoryName,
        COUNT(s.OrderNumber) AS total_orders,
        COUNT(DISTINCT s.CustomerKey) AS unique_customers,
        ROUND(
            (COUNT(s.OrderNumber) - COUNT(DISTINCT s.CustomerKey)) * 100.0 / COUNT(s.OrderNumber), 
            2
        ) AS category_repeat_rate
    FROM sales s
    JOIN Products p ON s.ProductKey = p.ProductKey
    JOIN &quot;Product Subcategories&quot; ps ON p.ProductSubcategoryKey = ps.ProductSubcategoryKey
    JOIN &quot;Product Categories&quot; pc ON ps.ProductCategoryKey = pc.ProductCategoryKey
    GROUP BY pc.CategoryName
),
CategoryReturns AS (
    -- Calculate Return metrics
    SELECT 
        pc.CategoryName,
        SUM(r.ReturnQuantity) AS total_returns_qty,
        COUNT(r.ReturnQuantity) AS return_incidents
    FROM Returns r
    JOIN Products p ON r.ProductKey = p.ProductKey
    JOIN &quot;Product Subcategories&quot; ps ON p.ProductSubcategoryKey = ps.ProductSubcategoryKey
    JOIN &quot;Product Categories&quot; pc ON ps.ProductCategoryKey = pc.ProductCategoryKey
    GROUP BY pc.CategoryName
)

SELECT 
    cs.CategoryName,
    cs.total_orders,
    cs.category_repeat_rate,
    COALESCE(cr.total_returns_qty, 0) AS total_returns_qty,
    -- Calculation: Return Rate % (What percentage of our orders come back?)
    ROUND(
        (COALESCE(cr.total_returns_qty, 0) * 100.0) / cs.total_orders, 
        2
    ) AS return_rate_pct
FROM CategorySales cs
LEFT JOIN CategoryReturns cr ON cs.CategoryName = cr.CategoryName
ORDER BY cs.total_orders DESC;

-- COUNT OF Orders -&gt; Repeats -&gt; Returns BY TERRITORY
WITH Regional_Sales AS (
    -- Get Total Orders by Region
    SELECT 
        TerritoryKey,
        COUNT(OrderNumber) AS total_orders
    FROM sales
    GROUP BY TerritoryKey
),
Regional_Repeats AS (
    -- Get Repeat Purchase Rates by Region
    SELECT 
        TerritoryKey,
        COUNT(OrderNumber) - COUNT(DISTINCT CustomerKey || ProductKey) AS repeat_order_count
    FROM sales
    GROUP BY TerritoryKey
),
Regional_Returns AS (
    -- Get Return Data by Region
    SELECT 
        TerritoryKey,
        SUM(ReturnQuantity) AS total_returns_qty,
        COUNT(*) AS return_incidents
    FROM Returns
    GROUP BY TerritoryKey
)

SELECT 
    st.Continent,
    st.Country,
    st.Region,
    rs.total_orders,
    rr.repeat_order_count,
    ROUND((rr.repeat_order_count * 100.0) / rs.total_orders, 2) AS repeat_rate_pct,
    COALESCE(rt.total_returns_qty, 0) AS total_returns_qty,
    ROUND((COALESCE(rt.total_returns_qty, 0) * 100.0) / rs.total_orders, 2) AS return_rate_pct
FROM &quot;Sales Territories&quot; st
JOIN Regional_Sales rs ON st.SalesTerritoryKey = rs.TerritoryKey
LEFT JOIN Regional_Repeats rr ON st.SalesTerritoryKey = rr.TerritoryKey
LEFT JOIN Regional_Returns rt ON st.SalesTerritoryKey = rt.TerritoryKey
ORDER BY rs.total_orders DESC;




-- SALES AND RETURN BASED ON PRICE

WITH Product_Sales_Bucket AS (
    SELECT 
        ProductKey, 
        SUM(OrderQuantity) AS total_sold
    FROM sales
    GROUP BY ProductKey
),
Product_Returns_Bucket AS (
    SELECT 
        ProductKey, 
        SUM(ReturnQuantity) AS total_returned
    FROM Returns
    GROUP BY ProductKey
)

SELECT 
    CASE 
        WHEN p.ProductPrice &lt; 50 THEN 'Low (&lt;$50)'
        WHEN p.ProductPrice BETWEEN 50 AND 500 THEN 'Medium ($50-$500)'
        ELSE 'High (&gt;$500)'
    END AS price_tier,
    SUM(psb.total_sold) AS units_sold,
    SUM(COALESCE(prb.total_returned, 0)) AS units_returned,
    ROUND(
        SUM(COALESCE(prb.total_returned, 0)) * 100.0 / SUM(psb.total_sold), 
        2
    ) AS return_rate_pct
FROM Products p
JOIN Product_Sales_Bucket psb ON p.ProductKey = psb.ProductKey
LEFT JOIN Product_Returns_Bucket prb ON p.ProductKey = prb.ProductKey
GROUP BY price_tier
ORDER BY return_rate_pct ASC;




-- FIGURING OUT WHY COMPONENT PRODUCT HAVE ZERO SALES
SELECT
	pc.CategoryName,
	count (ps.SubcategoryName) as category,
	group_concat(ps.SubcategoryName) as sub_categories
FROM &quot;Product Categories&quot; pc
LEFT JOIN &quot;Product Subcategories&quot; ps
	ON pc.ProductCategoryKey = ps.ProductCategoryKey
GROUP BY pc.CategoryName, pc.ProductCategoryKey
;


</sql><current_tab id="1"/></tab_sql></sqlb_project>
